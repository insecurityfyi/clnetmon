# Copy to /etc/nms/nms.env on the server (install.sh does this). Never commit real values.

# PostgreSQL. The default uses the local unix socket with peer auth (service user "nms").
NMS_DATABASE_URL=postgresql:///nms?host=/var/run/postgresql

# REST API bind. Keep on localhost unless you set NMS_API_TOKEN.
NMS_API_HOST=127.0.0.1
NMS_API_PORT=8080
# If set, every /api request must send "Authorization: Bearer <token>".
NMS_API_TOKEN=

# --- UniFi (UniFi OS console) ---
# Base URL of the console, no trailing path.
NMS_UNIFI_URL=https://192.168.1.1
# Network app -> Settings -> Control Plane -> Integrations -> Create API Key
NMS_UNIFI_API_KEY=
# Short site name used by the controller ("default" unless you renamed it).
NMS_UNIFI_SITE=default
# Consoles ship a self-signed certificate; set true once you install a trusted one.
NMS_UNIFI_VERIFY_TLS=false
# Optional fallback: a LOCAL read-only admin, used only if the console rejects the
# API key on the detailed (legacy) endpoints.
NMS_UNIFI_USERNAME=
NMS_UNIFI_PASSWORD=
# Seconds between polls.
NMS_UNIFI_INTERVAL=60

# --- SNMP (v2c, read-only) ---
# Community strings to try, in order. The first one a device answers to is remembered.
NMS_SNMP_COMMUNITIES=
# Devices that are always polled (IPs or names): switches, firewalls, printers, ...
NMS_SNMP_TARGETS=
# Discovery: networks to sweep for anything answering SNMP, e.g. 192.168.7.0/24.
# "auto" adds every subnet learned from the UniFi controller. Largest allowed is a /22.
NMS_SNMP_DISCOVERY=
# Seconds between polls, and between discovery sweeps.
NMS_SNMP_INTERVAL=120
NMS_SNMP_DISCOVERY_INTERVAL=3600

# Days of time-series history to keep.
NMS_RETENTION_DAYS=90
