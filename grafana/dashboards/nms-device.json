          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(c.display_name, a.ip, f.mac) AS \"Host\", COALESCE(a.ip, c.ip) AS \"IP\", f.mac AS \"MAC\", f.port_name AS \"Port\", NULLIF(f.vlan, 0) AS \"VLAN\", c.oui AS \"Vendor\" FROM fdb_entries f LEFT JOIN LATERAL (SELECT ip FROM arp_entries a WHERE a.mac = f.mac ORDER BY last_seen DESC LIMIT 1) a ON true LEFT JOIN clients c ON c.mac = f.mac WHERE f.device_mac = '$device' AND f.last_seen > now() - interval '15 minutes' UNION ALL SELECT c.display_name, c.ip, c.mac, COALESCE(c.sw_port::text, c.essid), c.vlan, c.oui FROM clients c WHERE c.connected AND '$device' IN (c.ap_mac, c.sw_mac) AND NOT EXISTS (SELECT 1 FROM fdb_entries f WHERE f.device_mac = '$device' AND f.mac = c.mac) ORDER BY 4, 1 LIMIT 500"
