          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT mem_pct FROM device_metrics WHERE mac = '$device' AND mem_pct IS NOT NULL AND time > now() - interval '15 minutes' ORDER BY time DESC LIMIT 1"
