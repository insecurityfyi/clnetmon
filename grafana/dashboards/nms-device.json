    {
      "id": 5,
      "title": "CPU",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nms-pg"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nms-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cpu_pct FROM device_metrics WHERE mac = '$device' AND cpu_pct IS NOT NULL AND time > now() - interval '15 minutes' ORDER BY time DESC LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
