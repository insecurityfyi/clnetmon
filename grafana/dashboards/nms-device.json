{
  "uid": "nms-device",
  "title": "Device detail",
  "tags": [
    "nms"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "nms"
      ],
      "asDropdown": false,
      "title": "NMS",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "nms-pg"
        },
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "query": "SELECT COALESCE(name, mac) || COALESCE(' (' || ip || ')', '') AS __text, mac AS __value FROM topology_devices ORDER BY (type IN ('firewall', 'router', 'ugw', 'udm', 'uxg')) DESC, name"
      },
      {
        "name": "interface",
        "label": "Interfaces",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "nms-pg"
        },
        "refresh": 2,
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "SELECT name FROM port_latest WHERE device_mac = '$device' AND (up OR COALESCE(rx_bps, 0) + COALESCE(tx_bps, 0) > 0) ORDER BY port_idx"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Device",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nms-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nms-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(name, mac) FROM topology_devices WHERE mac = '$device'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Type / address",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nms-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nms-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT concat_ws(' \u00b7 ', type, ip) FROM topology_devices WHERE mac = '$device'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
