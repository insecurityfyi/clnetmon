    {
      "id": 5,
      "title": "Interfaces with errors or discards",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nms-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 19,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nms-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.name AS \"Device\", d.mac AS \"MAC\", l.name AS \"Interface\", l.errors_ps AS \"Per second\", COALESCE(l.rx_errors, 0) + COALESCE(l.tx_errors, 0) AS \"Errors total\", COALESCE(l.rx_dropped, 0) + COALESCE(l.tx_dropped, 0) AS \"Discards total\" FROM port_latest l JOIN topology_devices d ON d.mac = l.device_mac WHERE l.errors_ps > 0 ORDER BY l.errors_ps DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Device"
            },
